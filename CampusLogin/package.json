{
  "name": "campuslogin",
  "productName": "CampusLogin",
  "version": "1.0.8",
  "description": "校园网（Dr.COM 门户）自动登录工具，托盘常驻，断线自动重连",
  "main": "src/main/index.js",
  "author": "陈成睿",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.campuslogin.app",
    "productName": "CampusLogin",
    "directories": {
      "output": "dist"
    },
    "publish": [],
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
